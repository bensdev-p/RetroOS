#!/bin/sh
# Install, remove and update software (run as root; D-055).
#
#   software install PKG...   fetch the package lists if stale, install
#   software remove PKG...    remove (and what only they needed)
#   software upgrade          fetch the lists, install every update
#   software check            fetch the lists; security updates by themselves
#                             unless turned off; count what is left
#   software security         install only the security updates
#   software cancel [force]   stop the running job (D-058): while it is
#                             downloading, at once (nothing has changed);
#                             while dpkg installs, after the step under way,
#                             then remove what it installed (Windows
#                             Installer's roll-back); "force" ends it now,
#                             as End Task does — the next job first repairs
#                             what was left half installed (dpkg --configure -a)
#
# apt's progress goes to standard output as its status lines (dlstatus:…,
# pmstatus:…) plus "step:" lines of our own; its messages go to
# /var/log/retroos-software.log, errors also to standard error. The
# Software Library, LIBRARY and INSTALL run this through sudo with the
# administrator's password; the daily check (retroos-updates.timer) as root.
#
# One job at a time, as dpkg's own lock and Windows Installer's "another
# installation is in progress": flock(1) on $RUN/lock, released by the
# kernel if we die. $RUN/job holds our pid and what we do, $RUN/progress
# apt's status lines, so any window can show a job another one started
# (retro_sys::software::running) — as GNOME Software shows PackageKit's.
# The window that started a job may close: the job carries on (SIGPIPE and
# SIGHUP ignored, so apt and dpkg are never stopped half way; HW 4.52).
set -eu
export DEBIAN_FRONTEND=noninteractive LC_ALL=C
LOG=/var/log/retroos-software.log
STATE=/var/lib/retroos/updates
CONF=/etc/retroos/updates.conf
RUN=/run/retroos-software
ERR=$(mktemp)
trap 'rm -f "$ERR"' EXIT
# Ctrl+C in a DOS Prompt must not cut dpkg off: only "cancel" stops a job.
trap '' PIPE HUP INT

# Our standard output and error may be gone: never let that stop us.
say() { printf '%s\n' "$*" || true; }
step() { say "step:$*"; printf 'step:%s\n' "$*" >>"$RUN/progress" 2>/dev/null || true; }

# apt-get with progress on fd 3 (to our stdout and $RUN/progress), its
# chatter in the log. Short network timeouts: offline fails in seconds.
apt() {
    rm -f "$RUN/failed"
    { apt-get -q -y -o APT::Status-Fd=3 \
        -o Acquire::Retries=1 -o Acquire::http::Timeout=20 -o Acquire::https::Timeout=20 \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        "$@" 3>&1 >>"$LOG" 2>"$ERR" || : >"$RUN/failed"; } | tee -p -a "$RUN/progress" || true
    cat "$ERR" >>"$LOG"
    if [ -e "$RUN/failed" ]; then
        stop_if_cancelled
        cat "$ERR" >&2 || true
        return 1
    fi
}

# "cancel" asked for while nothing had changed yet: stop here.
stop_if_cancelled() {
    if [ -e "$RUN/cancel" ]; then
        echo "Cancelled. Nothing was changed." >&2 || true
        exit 5
    fi
}

# A job ended by force (or a power cut) may have left packages half
# installed: finish them first, as apt itself asks ("dpkg was interrupted").
repair() {
    if [ -n "$(ls -A /var/lib/dpkg/updates 2>/dev/null)" ] || [ -n "$(dpkg --audit 2>/dev/null)" ]; then
        step "Finishing an interrupted installation"
        dpkg --force-confdef --force-confold --configure -a >>"$LOG" 2>&1 || true
        apt -f install || true
    fi
}

# Is the machine online? A default route on any interface, IPv4 or IPv6:
# PackageKit's own test when no network manager answers (its "unix"
# backend reads /proc/net/route). Wi-Fi is set up by iwd and the wire by
# networkd, so neither alone knows (networkd said "offline" on Wi-Fi,
# HW 4.60).
online() {
    awk 'NR > 1 && $2 == "00000000" { f = 1 } END { exit !f }' "${ROUTE4:-/proc/net/route}" 2>/dev/null ||
        awk '$1 == "00000000000000000000000000000000" && $2 == "00" && $10 != "lo" { f = 1 } END { exit !f }' \
            "${ROUTE6:-/proc/net/ipv6_route}" 2>/dev/null
}
offline() {
    echo "No internet connection. Connect to a network (NET, or Control Panel, Network) and try again." >&2 || true
    exit 4
}

# Are the package lists missing or older than a day?
stale() {
    [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*_Packages' -mtime -1 2>/dev/null | head -1)" ]
}

# The package lists: fetched when missing or older than a day.
fresh() {
    if stale; then
        step "Reading the package lists from the internet"
        apt update
    fi
}

# Count what is waiting, for the prompt and the System Bar.
count() {
    sim=$(apt-get -s -q -o Debug::NoLocking=1 upgrade --with-new-pkgs 2>/dev/null | grep '^Inst ' || true)
    n=$(printf '%s\n' "$sim" | grep -c '^Inst ' || true)
    s=$(printf '%s\n' "$sim" | grep -ci 'security' || true)
    mkdir -p "$(dirname "$STATE")"
    printf 'count=%s\nsecurity=%s\nchecked=%s\n' "$n" "$s" "$(date +%s)" >"$STATE.new"
    chmod 644 "$STATE.new"
    mv "$STATE.new" "$STATE"
}

# Only the security archive: apt sees just its sources (the classic
# security-only upgrade), so nothing else changes.
security() {
    d=$(mktemp -d)
    awk 'BEGIN{RS=""; ORS="\n\n"} /security/' /etc/apt/sources.list.d/debian.sources >"$d/security.sources"
    if [ -s "$d/security.sources" ]; then
        step "Installing security updates"
        apt -o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts="$d" upgrade || { rm -rf "$d"; return 1; }
    fi
    rm -rf "$d"
}

valid() {
    for p in "$@"; do
        case $p in
            [a-z0-9]*) ;;
            *) echo "Not a package name: $p" >&2; exit 2 ;;
        esac
        if printf '%s' "$p" | LC_ALL=C grep -q '[^a-z0-9+.-]'; then
            echo "Not a package name: $p" >&2; exit 2
        fi
    done
}

cmd=${1:-}
[ $# -gt 0 ] && shift

# Stop the running job (needs no lock: it is the job that holds it).
if [ "$cmd" = cancel ]; then
    pid=$(head -1 "$RUN/job" 2>/dev/null || true)
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        echo nothing
        exit 0
    fi
    what=$(sed -n 2p "$RUN/job")
    if [ "${1:-}" = force ]; then
        echo "$(date '+%F %T') software: force stop ($what)" >>"$LOG"
        pkill -KILL -s "$pid" || true
        echo stopped
        exit 0
    fi
    echo "$(date '+%F %T') software: cancel ($what)" >>"$LOG"
    : >"$RUN/cancel"
    if grep -q '^pmstatus:' "$RUN/progress" 2>/dev/null; then
        # dpkg is at work: never cut it off. An install is removed again
        # once the step under way is done; anything else just finishes.
        case $what in install*) echo undoing ;; *) echo finishing ;; esac
    else
        # Fetching lists or packages: stop apt now (dpkg has not started).
        pkill -TERM -s "$pid" -x apt-get || true
        echo stopping
    fi
    exit 0
fi

# Take the lock (flock holds it while we run; sudo's env_reset keeps
# callers from setting the variable themselves). Each job is a session of
# its own, so "cancel" reaches exactly its processes.
if [ -z "${RETROOS_SOFTWARE_LOCKED:-}" ]; then
    mkdir -p "$RUN"
    chmod 755 "$RUN"
    rc=0
    RETROOS_SOFTWARE_LOCKED=1 flock -n -E 75 "$RUN/lock" setsid -w "$0" "$cmd" "$@" || rc=$?
    if [ "$rc" -eq 75 ]; then
        echo "Another installation is running ($(sed -n 2p "$RUN/job" 2>/dev/null)). Wait for it to finish." >&2 || true
        exit 3
    fi
    exit "$rc"
fi
echo "$(date '+%F %T') software $cmd $*" >>"$LOG"
printf '%s\n%s\n' "$$" "$cmd $*" >"$RUN/job"
: >"$RUN/progress"
rm -f "$RUN/cancel"
chmod 644 "$RUN/job" "$RUN/progress"
# "cancel" sends apt-get SIGTERM; we carry on to say so.
trap 'true' TERM
trap 'rm -f "$ERR" "$RUN/job" "$RUN/failed" "$RUN/cancel"' EXIT

case $cmd in
    install)
        [ $# -gt 0 ] || { echo "Nothing to install" >&2; exit 2; }
        valid "$@"
        repair
        if stale; then online || offline; fi
        fresh
        stop_if_cancelled
        # Anything to download? Then the archive must be reachable.
        if apt-get install -qq --print-uris -- "$@" 2>/dev/null | grep -q "^'"; then
            online || offline
        fi
        # What is new, to remove again if this is cancelled while dpkg works.
        new=""
        for p in "$@"; do
            dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null | grep -qx installed || new="$new $p"
        done
        stop_if_cancelled
        step "Installing"
        apt install -- "$@"
        if [ -e "$RUN/cancel" ] && [ -n "$new" ]; then
            rm -f "$RUN/cancel"
            step "Cancelling: removing what was installed"
            # shellcheck disable=SC2086 # package names, checked by valid()
            apt remove --autoremove -- $new || true
            count
            echo "Cancelled. What was installed has been removed again." >&2 || true
            exit 5
        fi
        count ;;
    remove)
        [ $# -gt 0 ] || { echo "Nothing to remove" >&2; exit 2; }
        valid "$@"
        repair
        step "Removing"
        apt remove --autoremove -- "$@"; count ;;
    upgrade)
        online || offline
        repair
        step "Reading the package lists from the internet"
        apt update
        stop_if_cancelled
        step "Installing updates"
        apt upgrade --with-new-pkgs; count ;;
    check)
        # Offline: count from the lists we have; try again tomorrow.
        if apt update; then
            grep -qx 'security=off' "$CONF" 2>/dev/null || security || true
        fi
        count ;;
    security)
        security; count ;;
    *) echo "usage: software install|remove PKG... | upgrade | check | security | cancel [force]" >&2; exit 2 ;;
esac
