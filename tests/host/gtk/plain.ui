<?xml version="1.0"?>
<!-- A plain GTK 3 window for tests/host/gtk.steps (D-056): menus, a field, a check box, a radio button, a combo box, a slider, buttons. -->
<interface>
  <object class="GtkWindow" id="w">
    <property name="title">Plain GTK Window</property>
    <property name="default-width">520</property>
    <property name="default-height">300</property>
    <child>
      <object class="GtkBox"><property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">12</property>
        <child><object class="GtkMenuBar"><property name="visible">True</property><child><object class="GtkMenuItem"><property name="visible">True</property><property name="label">File</property></object></child><child><object class="GtkMenuItem"><property name="visible">True</property><property name="label">Edit</property></object></child></object></child>
        <child><object class="GtkLabel"><property name="visible">True</property><property name="label">A label in a plain GTK 3 window.</property><property name="xalign">0</property></object></child>
        <child><object class="GtkEntry"><property name="visible">True</property><property name="text">Some text</property></object></child>
        <child><object class="GtkCheckButton"><property name="visible">True</property><property name="label">A check box</property><property name="active">True</property></object></child>
        <child><object class="GtkRadioButton"><property name="visible">True</property><property name="label">A radio button</property></object></child>
        <child><object class="GtkComboBoxText"><property name="visible">True</property><items><item>Choice one</item><item>Choice two</item></items><property name="active">0</property></object></child>
        <child><object class="GtkScale"><property name="visible">True</property><property name="adjustment">adj</property><property name="draw-value">False</property></object></child>
        <child><object class="GtkBox"><property name="visible">True</property><property name="spacing">8</property><property name="halign">end</property>
          <child><object class="GtkButton"><property name="visible">True</property><property name="label">OK</property></object></child>
          <child><object class="GtkButton"><property name="visible">True</property><property name="label">Cancel</property></object></child>
        </object></child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="adj"><property name="upper">100</property><property name="value">40</property></object>
</interface>
