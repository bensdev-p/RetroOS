# Software Library (D-055) with a pretend system (RETROOS_TEST_SOFTWARE:
# htop installed, three updates, password "retro"): LIBRARY, INSTALL and
# UNINSTALL in RetroDOS (the password, given once, is remembered for a few
# minutes, as sudo does), then the Desktop's Software Library.
wait 1500
# The daily check's count (RETROOS_UPDATES_STATE) shows under the logo.
shot 00-notice
type LIBRARY
key enter
wait 1500
shot 01-library
key down
key down
key down
key down
key right
wait 300
shot 02-games
key enter
wait 500
shot 03-password
type retro
key enter
wait 800
shot 04-installing
wait 2500
shot 05-installed
key escape
key escape
wait 600
type INSTALL GIMP
key enter
wait 3000
shot 06-install-cli
type UNINSTALL GIMP
key enter
wait 600
type y
key enter
wait 3000
shot 07-uninstall-cli
type DESKTOP
key enter
wait 1500
type START software-library
key enter
wait 2500
expect WINDOWS => normal Software Library
shot 08-library-gui
key down
key down
key down
key down
key down
key down
key tab
key down
wait 300
shot 09-programming
key enter
wait 800
shot 10-gui-password
type retro
key enter
wait 800
shot 11-gui-installing
wait 2500
shot 12-gui-installed
key enter
wait 500
key escape
wait 800
# Control Panel → Updates and Software Sources; the bar's updates mark.
type START control-panel updates
key enter
wait 2500
expect WINDOWS => normal Updates
shot 13-updates-page
key escape
wait 500
key alt+f4
wait 800
type START control-panel sources
key enter
wait 2500
shot 14-sources-page
key escape
wait 500
key alt+f4
wait 800
