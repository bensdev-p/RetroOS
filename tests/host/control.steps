# Control Panel: CONTROL in text mode, then the Desktop's Control Panel
# from the System Bar. Settings go to ~/startup.conf (RETROOS_STARTUP_CONF).
wait 1500
type CONTROL
key enter
wait 1500
shot 01-control-text
# S → Startup; Enter opens the page; → changes "Start in"; Enter saves.
type s
key enter
wait 500
shot 02-control-startup
key right
key enter
wait 800
expect-file startup.conf mode=desktop
# Users: the page, then the New User form (not submitted: no sudo here).
type u
key enter
wait 500
key tab
key enter
wait 300
type sam
key tab
type Sam Smith
key tab
type secret1
wait 300
shot 02b-users-form-text
key escape
key escape
wait 300
key escape
wait 800
type DESKTOP
key enter
wait 1500
# ◆ menu: About This Computer, then Control Panel.
pointer 36 20
button click
wait 600
key down
key down
key enter
wait 2500
expect WINDOWS => normal Control Panel
shot 03-control-panel
# Network: the Wireless Networks dialog (a pretend adapter here,
# RETROOS_TEST_WIFI), enterprise sign-in, and a fixed wired address.
type n
key enter
wait 1000
shot 03a-network
key enter
wait 1000
shot 03b-wifi
key down
key enter
wait 800
type jo@uni.edu
key tab
type secret
wait 300
shot 03c-enterprise
key escape
wait 300
key escape
wait 500
key tab
key space
wait 500
key down
key enter
wait 300
key tab
type 192.168.1.50/24
key tab
type 192.168.1.1
wait 300
shot 03d-fixed
key escape
wait 500
key home
# Display: Enter on the first icon; Space drops the scheme list down;
# ↓ Enter picks Paper; Enter is OK.
key enter
wait 1000
shot 04-display
key space
wait 600
shot 05-display-drop
key down
key enter
wait 400
shot 05b-display-paper
key enter
wait 1500
expect-file startup.conf scheme=paper
shot 06-paper
# Date & Time: no clock service here, so the page says so.
type d
key enter
wait 1000
shot 07-datetime
key escape
wait 500
# Keyboard: a long list; typing a letter jumps.
type k
key enter
wait 1000
type g
wait 300
shot 08-keyboard
key escape
wait 500
# Users on the Desktop: the list, then New User.
type u
key enter
wait 1000
shot 09-users
key tab
key enter
wait 800
type sam
key tab
type Sam Smith
key tab
type secret1
wait 300
shot 10-new-user
key escape
wait 300
key escape
wait 500
key alt+f4
wait 800
expect-task 1
