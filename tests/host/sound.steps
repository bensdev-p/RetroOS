# Sound (D-047) with a pretend sound system (RETROOS_TEST_SOUND): VOLUME,
# MIXER, and the Control Panel's Sound page in both front-ends.
wait 1500
type VOLUME
key enter
wait 600
shot 01-volume
type MIXER
key enter
wait 1500
shot 02-mixer
key up
key up
key right
key m
wait 600
shot 03-mixer-changed
key escape
wait 500
type CONTROL SOUND
key enter
wait 1500
shot 04-control-sound
key escape
key escape
wait 500
type DESKTOP
key enter
wait 1500
type START control-panel sound
key enter
wait 2500
expect WINDOWS => normal Sound
shot 05-sound-page
key escape
wait 500
key alt+f4
wait 1000
# The Volume window (D-053) and the System Bar's speaker.
type START volume
key enter
wait 2500
expect WINDOWS => normal Volume
shot 06-volume
key escape
wait 800
pointer 1765 10
button click
wait 800
shot 07-bar-volume
key escape
wait 500
expect SOUND beep => OK
expect SOUND nonsense => quiet
