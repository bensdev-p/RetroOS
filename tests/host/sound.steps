# Sound (D-047) with a pretend sound system (RETROOS_TEST_SOUND): VOLUME,
# MIXER, and the Control Panel's Sound page in both front-ends.
wait 1500
type VOLUME
key enter
wait 600
shot 01-volume
type MIXER
key enter
wait 1500
shot 02-mixer
key up
key up
key right
key m
wait 600
shot 03-mixer-changed
key escape
wait 500
type CONTROL SOUND
key enter
wait 1500
shot 04-control-sound
key escape
key escape
wait 500
type DESKTOP
key enter
wait 1500
type START control-panel sound
key enter
wait 2500
expect WINDOWS => normal Sound
shot 05-sound-page
key escape
